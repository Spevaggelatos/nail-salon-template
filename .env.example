# ==========================================================
# GOOGLE CALENDAR API INTEGRATION (PROD CONFIGURATION)
# ==========================================================
# Όταν αυτά τα πεδία είναι κενά, το site λειτουργεί αυτόματα σε
# SIMULATION / DEMO MODE ώστε να μπορείτε να δοκιμάσετε
# τα πάντα (slots, τεχνίτριες, κρατήσεις) χωρίς σφάλματα!

# 1. Email του Google Cloud Service Account (το ρομποτάκι)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# 2. Private Key του Google Cloud Service Account
GOOGLE_PRIVATE_KEY=""

# 3. Google Calendar IDs ανά τεχνίτρια (από τις ρυθμίσεις του Google Calendar)
# Αν έχετε 1 κοινό ημερολόγιο για όλες, βάζετε το ίδιο ID ή "primary"
GOOGLE_CALENDAR_ID_ANNA=""
GOOGLE_CALENDAR_ID_MARIA=""
GOOGLE_CALENDAR_ID_ELENI=""
